{
  "name": "live2d-agent",
  "version": "2.0.0",
  "private": true,
  "description": "Live2D AI Agent — karakter Live2D yang dikendalikan AI (Bun + TypeScript)",
  "scripts": {
    "dev": "bun run src/server/index.ts",
    "start": "bun run src/server/index.ts",
    "build": "bun run src/build.ts",
    "test": "bun test && bun run test/run-guards.js",
    "test:unit": "bun test",
    "test:guards": "bun run test/run-guards.js",
    "build:pet": "cd agent-shell && bunx @tauri-apps/cli build",
    "dev:pet": "cd agent-shell && bunx @tauri-apps/cli build --debug",
    "dist": "bun run src/dist.ts",
    "agent": "bun run src/cli/agent.ts"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "bun-types": "^1.4.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
